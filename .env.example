# 로그인된 공식 Codex / Claude Code 구독을 사용합니다.
RESEARCH_MODE=subscription
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
ENABLE_WEB_SEARCH=true
DATA_DIR=./data
PORT=3000
# API 키는 필요하지 않으며 구독 실행 프로세스에 전달하지 않습니다.
# GitHub 새 버전 알림과 자동 업데이트 버튼 (false로 끄기)
ENABLE_SELF_UPDATE=true
